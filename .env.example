# Kontaktformular-Versand
# Bevorzugt: Resend (eigene Domain). Wenn RESEND_API_KEY gesetzt ist,
# wird darüber versendet — sonst Fallback auf FormSubmit.
RESEND_API_KEY=
# Absender muss auf der in Resend verifizierten Domain liegen:
CONTACT_FROM_EMAIL="FPZ Website <kontakt@fapez-medien.de>"
# Zieladresse (wohin die Anfragen gehen):
CONTACT_TO_EMAIL=stevanfrei@gmail.com

# Optional: FormSubmit-Endpoint überschreiben (Fallback-Versand)
# CONTACT_FORM_ENDPOINT=

# Rate-Limiting (optional, aber empfohlen): Upstash Redis REST (Gratis-Tier)
# https://upstash.com -> Redis-DB erstellen -> REST URL + Token kopieren
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
